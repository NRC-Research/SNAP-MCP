free format
#<Regression>
#  <Author>Jay Spore</Author>
#  <Format>TRACE</Format>
#  <Restart />
#  <ParallelCases />
#  <SupportFiles />
#  <Suites>
#    Contan
#  </Suites>
#  <FailureMode />
#  <Purpose>
#    Same as test problem CONTAN1, except CONTAN component added.
#  </Purpose>
#  <PermutationOf>
#    CONTAN1
#  </PermutationOf>
#  <SuccessCriteria>
#     <Test name="CONTAN Test">
#        <Description>
#          Verify that flow from break ends up in CONTAN compartment.
#          <!-- 82.189 is the initial steam and liquid mass in the CONTAN
#               compartment. In addition, the CONTAN solver is solved at
#               beginning of the time step and the flow into the BREAK is
#               solved at the end of the time step. Therefore, there will
#               be one time step difference between the time integrated
#               mass flow rate into the BREAK and the accumulated liquid
#               and steam in the CONTAN compartment. The mass of air
#               in the CONTAN compartment will not change with time.
#               The time integrated mass flow rate into the BREAK is
#               expected to be approximately the same as the accumulation
#               of steam and liquid water in the CONTAN compartment.
#               If not, then there is a potential problem with the communication
#               logic between the BREAK and CONTAN compartment, or a problem
#               the CONTAN mass conservation equation, or a problem with the
#               calculation of bsmass for the BREAK component. Some adjustment
#               with the assertion success criteria may be required, but a
#               significant adjustment could indicate a code error. -->
#        </Description>
#        <Assertion times="-1.0" eps="0.1%">
#           u = mod : self : bsmass-3
#           w = mod : self : rml-7A01
#           x = mod : self : rms-7A01
#           assert u == w + x - 82.189
#        </Assertion>
#        <Description>
#          Verify that solute that flows into the BREAK component accumulates
#          the CONTAN compartment.
#          <!-- The time integrated mass flow rate of solute is expected to
#               approximately equal to the accumulation of solute in the CONTAN
#               compartment. The CONTAN time dependent solution is solved at the
#               beginning of the time step and the BREAK component mass flow rates
#               are determined at the end of the time step. Therefore, there is
#               one time step difference between the CONTAN compartment accumulation
#               of solute and time integration of the BREAK solute mass flow rate.
#               If these parameters are not approximately equal, then there is a
#               potential problem with the communication logic between the BREAK
#               and CONTAN compartment, or a problem with the calcuation of mSolC
#               in the BREAK compartment, or a problem with solute mass conservation
#               equation in the CONTAN compartment. Some adjustment
#               with the assertion success criteria may be required, but a
#               significant adjustment could indicate a code error.-->
#        </Description>
#        <Assertion times="-1.0" eps="0.1%">
#           u = mod : self : mSolC-3
#           w = mod : self : rmb-7A01
#           assert w == u
#        </Assertion>
#     </Test>
#  </SuccessCriteria>
#</Regression>
