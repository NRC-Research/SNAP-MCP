free format
#<Regression>
#  <Author>JaySpore</Author>
#  <Format>TRACE</Format>
#  <Restart />
#  <ParallelCases />
#  <SupportFiles />
#  <Suites>
#    ConSys
#    Pump
#    Backup
#  </Suites>
#  <FailureMode />
#  <Purpose>
#     pump motor torque test problem - IPMPTY = 3.
#     This test is identical to PumpTorq2 with the added feature
#     that IPMPTR points to trip 1.  Initial motor torque will be
#     1000 N-m before trip and then 500 N-m after trip.
#  </Purpose>
#  <PermutationOf>
#     PumpTorq2
#  </PermutationOf>
#  <SuccessCriteria>
#    <Test name="PumpTorque">
#      <Description></Description>
#      <Assertion times="-1.0" eps="0.1%">
#           x = mod : PumpTorq2 : torque-700
#           y = mod : self : torque-700
#           assert x == y
#      </Assertion>
#    </Test>
#  </SuccessCriteria>
#</Regression>
*
*
*************
* main data *
*************
*
*       numtcr          ieos         inopt          nmat          id2o
             8             0             1             0             0
*-*-*TEST PROBLEM PumpTorq3
*******************************************
pump motor torque test problem
*******************************************
*
*  This test is identical to PumpTorq2 with the added feature
*  that IPMPTR points to trip 1.  Initial motor torque will be
*  1000 N-m before trip and then 500 N-m after trip.
*
*
*****************
* namelist data *
*****************
*
 &inopts
  cpuflg=1,
  iadded=10,
  icflow=2,
  idiag=4,
  ikfac=1,
  noair=0,
  nsdl=0,
  nsdu=5,
  nspl=0,
  nspu=5,
  use_IAPWS_st=.TRUE.,
  usesjc=3,
  graphlevel='full',
 &end
