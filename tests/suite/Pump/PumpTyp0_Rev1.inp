free format
#<Regression>
# <Author>Jay Spore</Author>
# <Format>TRACE</Format>
# <Restart />
# <ParallelCases />
# <SupportFiles />
# <Suites>
#   Pump
# </Suites>
# <FailureMode />
# <Purpose>
#    Same as test problem PumpTyp0, except NPMPSD was changed from -1 to 2.
#    Signal variable 2 is trip status for trip 11.
#    Trip 11 is initially off, then goes on at 100 secs and then off again at 300 secs.
# </Purpose>
# <PermutationOf>PumpTyp0</PermutationOf>
# <SuccessCriteria>
#     <Test name="Pump Type 0 - Test 2">
#        <Description>
#          Check to see if PUMP IPMPTY = 0 behaves as expected when trip is
#          off, then on, then off.  When trip is off, flow (and fluid velocity) should
#          be zero.
#        </Description>
#        <Assertion times="99.0" eps="0.01">
#           x = mod : self : vln-13A02
#           y = mod : self : flow-13
#           z = mod : self : sv2
#           assert x == 0.0
#           assert y == z
#        </Assertion>
#        <Assertion times="200.0" eps="0.01%">
#           x = mod : self : vln-13A02
#           y = mod : self : flow-13
#           assert x == 14.0
#           assert y == 7.0
#        </Assertion>
#        <Assertion times="310.0" eps="0.01">
#           x = mod : self : vln-13A02
#           y = mod : self : flow-13
#           z = mod : self : sv2
#           assert x == 0.0
#           assert y == z
#        </Assertion>
#     </Test>
# </SuccessCriteria>
#</Regression>
